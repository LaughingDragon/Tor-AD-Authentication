@model AccountPasswordViewModel
@* Fallback template for the AccountPassword shape: plain markup, no classes. A theme can override it (for example with AccountPassword.liquid). *@
<section id="account-password">
    <h2>Change domain password</h2>
    <form method="post" action="@Model.ActionUrl">
        @Html.AntiForgeryToken()
        <p><label for="CurrentPassword">Current password</label><br><input id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" maxlength="@Model.MaxLength" required></p>
        <p><label for="NewPassword">New password</label><br><input id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" maxlength="@Model.MaxLength" required></p>
        <p><label for="ConfirmPassword">Confirm new password</label><br><input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" maxlength="@Model.MaxLength" required></p>
        <p><button type="submit">Change password</button></p>
    </form>
</section>
