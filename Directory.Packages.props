<Project>
  <!-- Every package version is pinned here. Source: nuget.org only (nuget.config). -->
  <ItemGroup>
    <PackageVersion Include="OrchardCore.Module.Targets" Version="3.0.1" />
    <PackageVersion Include="OrchardCore.ContentManagement" Version="3.0.1" />
    <PackageVersion Include="OrchardCore.DisplayManagement" Version="3.0.1" />
    <PackageVersion Include="OrchardCore.Users.Core" Version="3.0.1" />
    <PackageVersion Include="OrchardCore.Media.Core" Version="3.0.1" />
    <PackageVersion Include="OrchardCore.Media" Version="3.0.1" />
    <PackageVersion Include="OrchardCore.AuditTrail.Abstractions" Version="3.0.1" />
    <PackageVersion Include="OrchardCore.Workflows.Abstractions" Version="3.0.1" />
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.14" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!-- Transitive pins (same as the site this came from): SixLabors.ImageSharp comes with OrchardCore.Media and is
       held at the same version as before; Pkcs is a patched version for a NuGet audit finding. -->
  <ItemGroup>
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
